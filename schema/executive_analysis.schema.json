{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "executive_analysis.schema.json",
  "title": "MEIP Executive Analysis",
  "description": "A validated intelligence layer generated from report_brief.json. It explains what matters, why it matters, what should be presented, and which validated source values support each conclusion. This document must never introduce unsupported numbers.",
  "type": "object",
  "required": ["analysis_meta", "primary_message", "findings", "risks", "opportunities", "recommended_actions", "presentation_plan", "source_values_used"],
  "additionalProperties": false,
  "definitions": {
    "dataRef": {
      "type": "string",
      "description": "JSONPath-like pointer into the originating report_brief.json, e.g. sections[1].kpis[0].value"
    },
    "evidence": {
      "type": "object",
      "required": ["data_ref", "label", "value"],
      "additionalProperties": false,
      "properties": {
        "data_ref": {"$ref": "#/definitions/dataRef"},
        "label": {"type": "string"},
        "value": {"type": ["number", "string", "null"]},
        "unit": {"type": "string"},
        "evidence_status": {
          "type": "object",
          "description": "Carried forward from the source report_brief.json object at data_ref, when present there. See docs/DATA_INTEGRITY_STANDARD.md.",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": ["VERIFIED", "DERIVED", "USER_CONFIRMED", "PARTIALLY_VERIFIED", "CONFLICTING", "MISSING", "NOT_APPLICABLE"]
            },
            "note": {"type": "string"}
          }
        }
      }
    },
    "insight": {
      "type": "object",
      "required": ["id", "type", "priority", "headline", "interpretation", "business_impact", "confidence", "supporting_evidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string", "enum": ["finding", "risk", "opportunity", "action"]},
        "priority": {"type": "integer", "minimum": 1, "maximum": 5, "description": "1 is highest priority."},
        "headline": {"type": "string"},
        "interpretation": {"type": "string"},
        "business_impact": {"type": "string"},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "supporting_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/evidence"}},
        "magnitude_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Real computed severity signal (target deviation, concentration share, or peak share), 0-100. Only present when a rule can compute it from validated source values -- absence means no signal, not zero severity, and scoring must not treat it as zero."
        },
        "derived_from_id": {
          "type": "string",
          "description": "For type=action: the id of the finding/risk this action addresses. Lets prioritisation fold the action into its parent's decision object instead of ranking the same underlying issue twice."
        }
      }
    },
    "planItem": {
      "type": "object",
      "required": ["section_id", "reason", "priority"],
      "additionalProperties": false,
      "properties": {
        "section_id": {"type": "string"},
        "reason": {"type": "string"},
        "priority": {"type": "integer", "minimum": 1, "maximum": 5},
        "preferred_width": {"type": "string", "enum": ["full", "half", "third"]}
      }
    }
  },
  "properties": {
    "analysis_meta": {
      "type": "object",
      "required": ["source_report_title", "source_report_type", "generated_from"],
      "additionalProperties": false,
      "properties": {
        "source_report_title": {"type": "string"},
        "source_report_type": {"type": "string"},
        "generated_from": {"type": "string"}
      }
    },
    "primary_message": {
      "type": "object",
      "required": ["headline", "summary", "confidence", "supporting_evidence"],
      "additionalProperties": false,
      "properties": {
        "headline": {"type": "string"},
        "summary": {"type": "string"},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "supporting_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/evidence"}}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/definitions/insight"}},
    "risks": {"type": "array", "items": {"$ref": "#/definitions/insight"}},
    "opportunities": {"type": "array", "items": {"$ref": "#/definitions/insight"}},
    "recommended_actions": {"type": "array", "items": {"$ref": "#/definitions/insight"}},
    "presentation_plan": {"type": "array", "items": {"$ref": "#/definitions/planItem"}},
    "source_values_used": {"type": "array", "items": {"$ref": "#/definitions/evidence"}}
  }
}
